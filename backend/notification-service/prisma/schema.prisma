datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Notification {
  id        String   @id @default(uuid())
  bookingId String?
  userEmail String
  type      String
  title     String
  message   String
  status    String   @default("UNREAD")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  email     String   @id
  name      String
  role      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
