datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Resource {
  id               String   @id
  name             String
  type             String
  building         String
  floor            Int
  department       String
  capacity         Int
  facilities       String[]
  status           String   @default("active")
  requiresApproval Boolean  @default(false)
  coordinatorEmail String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model User {
  email     String   @id
  name      String
  role      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
